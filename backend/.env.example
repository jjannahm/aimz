APP_NAME=AIMZ Egypt API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://aimz:change-me@localhost:5432/aimz
BACKEND_CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
SQL_ECHO=false
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=15

ADMIN_NAME=AIMZ Admin
ADMIN_EMAIL=admin@aimz.example
ADMIN_PASSWORD=change-this-admin-password
INITIAL_INVITE_CODE=AIMZ-PLAY
REVIEW_NAME=
REVIEW_EMAIL=
REVIEW_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=scores@aimz.example
SMTP_START_TLS=true

S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PRESIGN_SECONDS=900
MEDIA_MAX_BYTES=5242880
MEDIA_ENABLED=true
