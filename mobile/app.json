{
  "expo": {
    "name": "AIMZ Egypt",
    "slug": "aimz-egypt",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "aimz",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/branding/icon.png",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AIMZ Egypt to choose player and team photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/branding/favicon.png",
      "name": "AIMZ Egypt",
      "shortName": "AIMZ",
      "themeColor": "#020817",
      "backgroundColor": "#020817",
      "display": "standalone"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aimzegypt.scores",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aimzegypt.scores"
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
