{
  "expo": {
    "name": "AIMZ Egypt",
    "slug": "aimz-egypt",
    "owner": "jjannah",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "aimz",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/branding/icon.png",
