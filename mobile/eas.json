{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8000"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://aimz-api-staging.shared-links.workers.dev",
        "EXPO_PUBLIC_WEB_ORIGIN": "https://aimz-egypt-staging.pages.dev",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_ENABLE_MEDIA": "true",
        "EXPO_PUBLIC_ENABLE_PASSWORD_RESET": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://aimz-api-production.shared-links.workers.dev",
        "EXPO_PUBLIC_WEB_ORIGIN": "https://aimz-egypt-production.pages.dev",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ENABLE_MEDIA": "true",
        "EXPO_PUBLIC_ENABLE_PASSWORD_RESET": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
