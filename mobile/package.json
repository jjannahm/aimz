{
  "name": "aimz-egypt",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "web:export": "expo export --platform web && node scripts/inject-web-branding.mjs",
    "web:deploy:cloudflare": "wrangler pages deploy dist --project-name aimz-egypt-staging --branch main",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "api:types": "openapi-typescript ${EXPO_PUBLIC_API_URL:-http://127.0.0.1:8000}/openapi.json -o src/types/generated.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-font": "57.0.1",
    "expo-haptics": "^57.0.1",
    "expo-image-manipulator": "^57.0.12",
    "expo-image-picker": "^57.0.12",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-secure-store": "^57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.7",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.123.0"
  }
}
