{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aimz-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "staging",
    "FRONTEND_ORIGIN": "https://aimz-egypt-staging.pages.dev",
    "PUBLIC_FORM_ORIGIN": "https://aimz-egypt-staging.pages.dev",
    "TURNSTILE_HOSTNAMES": "aimz-egypt-staging.pages.dev",
    "ADMIN_NAME": "AIMZ Staging Admin",
    "ACCESS_TOKEN_SECONDS": "900",
    "REFRESH_TOKEN_DAYS": "30",
    // "on" keeps the web app's refresh token in an HttpOnly cookie, out of reach
    // of scripts on the page. Only once the web app and this API are one site:
    // pages.dev and workers.dev are two, Safari refuses the cookie there as
    // third-party, and every Safari session would end at its first refresh.
    "REFRESH_COOKIE": "off",
    "MEDIA_MAX_BYTES": "5242880"
  },
  // Nightly, a little after 3am Cairo: the activity log keeps a month, and the
  // purge that enforces it must not wait on somebody opening the screen.
  "triggers": {
    "crons": ["0 1 * * *"]
  },
  // Sign-in and refresh are the two doors that open without a session, and
  // the first of them runs 600,000 rounds of PBKDF2 per attempt. The account
  // buckets are tight because one account being tried repeatedly is either a
  // forgotten password or an attack. The address buckets are deliberately
  // loose: a whole squad's parents behind one school's wifi, or an Egyptian
  // carrier's NAT, are one address to us, and locking them out together would
  // be a worse outage than the abuse it prevents.
  //
  // Invitation codes are credentials as well, so looking one up and spending
  // one on registration are held per address; a password change is held per
  // account, so a session picked up from an unlocked phone cannot be used to
  // guess the password behind it.
  "ratelimits": [
    { "name": "LOGIN_BY_ACCOUNT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_BY_IP", "namespace_id": "2002", "simple": { "limit": 100, "period": 60 } },
    { "name": "REFRESH_BY_TOKEN", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
    { "name": "REFRESH_BY_IP", "namespace_id": "2004", "simple": { "limit": 300, "period": 60 } },
    { "name": "INVITE_BY_IP", "namespace_id": "2005", "simple": { "limit": 30, "period": 60 } },
    { "name": "REGISTER_BY_IP", "namespace_id": "2006", "simple": { "limit": 20, "period": 60 } },
    { "name": "PASSWORD_BY_ACCOUNT", "namespace_id": "2007", "simple": { "limit": 5, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aimz-staging-db",
      "database_id": "09e5f039-a7ed-4249-975d-a3b3e4467dc0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "aimz-staging-media"
    }
  ],
  "observability": {
    "enabled": true,
    // Head sampling drops every log inside an unsampled request, errors
    // included, so it stays at 1 and the volume is cut where the volume
    // actually is: the automatic per-request line. At a hundred and fifty
    // requests a second that line is the log bill, and it says nothing our
    // own warnings and errors do not.
    "logs": { "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },

  // Production. Wrangler does not inherit `vars` or bindings into a named
  // environment, so every one is repeated here rather than shared with the
  // staging config above. That is the point: a production Worker should never
  // be one deleted line away from writing to the staging database.
  //
  // Secrets are deliberately absent -- JWT_SECRET, DATA_ENCRYPTION_KEY,
  // TURNSTILE_SECRET, INITIAL_INVITE_CODE, ADMIN_EMAIL and ADMIN_PASSWORD are
  // set with `wrangler secret put --env production` and never committed. The
  // Worker answers 503 until JWT_SECRET and DATA_ENCRYPTION_KEY are set.
  "env": {
    "production": {
      "name": "aimz-api-production",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "production",
        // The production Pages project. Replace all three together if the web
        // app moves to a custom domain -- and serve this API from the same
        // domain, which is what would let REFRESH_COOKIE be turned on.
        "FRONTEND_ORIGIN": "https://aimz-egypt-production.pages.dev",
        "PUBLIC_FORM_ORIGIN": "https://aimz-egypt-production.pages.dev",
        "TURNSTILE_HOSTNAMES": "aimz-egypt-production.pages.dev",
        "ADMIN_NAME": "AIMZ Egypt Admin",
        "ACCESS_TOKEN_SECONDS": "900",
        "REFRESH_TOKEN_DAYS": "30",
        "REFRESH_COOKIE": "off",
        "MEDIA_MAX_BYTES": "5242880"
      },
      "triggers": {
        "crons": ["0 1 * * *"]
      },
      // The same limits as staging, in namespaces of their own, so attempts
      // against the preview can never spend a production account's budget.
      "ratelimits": [
        { "name": "LOGIN_BY_ACCOUNT", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
        { "name": "LOGIN_BY_IP", "namespace_id": "3002", "simple": { "limit": 100, "period": 60 } },
        { "name": "REFRESH_BY_TOKEN", "namespace_id": "3003", "simple": { "limit": 10, "period": 60 } },
        { "name": "REFRESH_BY_IP", "namespace_id": "3004", "simple": { "limit": 300, "period": 60 } },
        { "name": "INVITE_BY_IP", "namespace_id": "3005", "simple": { "limit": 30, "period": 60 } },
        { "name": "REGISTER_BY_IP", "namespace_id": "3006", "simple": { "limit": 20, "period": 60 } },
        { "name": "PASSWORD_BY_ACCOUNT", "namespace_id": "3007", "simple": { "limit": 5, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aimz-production-db",
          "database_id": "9c8593a9-43db-4742-9bd0-80c208a5429d",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "aimz-production-media"
        }
      ],
      "observability": {
        "enabled": true,
        "logs": { "head_sampling_rate": 1, "invocation_logs": false },
        "traces": { "enabled": true, "head_sampling_rate": 0.05 }
      }
    }
  }
}
